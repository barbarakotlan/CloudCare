# Copy to .env.local and fill in. Everything here is public (NEXT_PUBLIC_* ships to the browser).
# Never put a Supabase secret / service_role key in this file.

# FastAPI backend (see backend/). Default: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (no NEXT_PUBLIC_ prefix): the FastAPI URL the MyChart route handlers
# (/api/auth/epic, /api/auth/callback/epic) call server to server. Falls back to
# NEXT_PUBLIC_API_URL when empty.
CLOUDCARE_API_URL=

# "supabase" (Supabase Auth; the backend verifies its tokens) or "backend"
# (FastAPI POST /auth/login demo tokens, works offline). Default: backend.
NEXT_PUBLIC_AUTH_PROVIDER=backend

# Only needed when NEXT_PUBLIC_AUTH_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tvqmphtgtnzxhyszcdmi.supabase.co
# Dashboard -> Project Settings -> API Keys -> publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key; used only if the one above is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ElevenLabs Conversational AI agent for "Talk to Foggy". Leave empty to show the
# "voice demo not configured yet" state.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# In-browser voice ("Talk to Foggy") is billed per session: anything but "on" hides it everywhere.
NEXT_PUBLIC_VOICE_ENABLED=off

# Sales chat bubble ("talk to Barbara") on the public pages. Set to off to hide it site-wide.
NEXT_PUBLIC_SALES_CHAT=on
