# Copy this file to backend/.env and fill in real values. Never commit .env.

# Postgres connection string. Leave unset (or empty) to use the local SQLite file.
# Supabase: Dashboard -> Connect -> "Session pooler" (IPv4, port 5432). Copy the host
# from the dialog; postgresql:// URLs are converted to the psycopg driver automatically.
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres
# The transaction pooler (port 6543) also works; prepared statements are turned off for it.
# Create the tables once with database/scheme.sql, then run database/supabase_rls.sql.
DATABASE_URL=

# Secret for signing demo login tokens (POST /auth/login). Any long random string;
# share privately with the team. Required in any deployed environment.
JWT_SECRET=change-me-to-a-long-random-string

# Supabase Auth. Setting SUPABASE_URL makes the API accept Supabase access tokens
# (verified with the project's public signing keys, no secret needed for that).
SUPABASE_URL=
# Server-only key (legacy service_role JWT or a new sb_secret_ key). Used only at
# startup to create the demo accounts in Supabase Auth. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,https://cloudcare.icu,https://www.cloudcare.icu

# ---- Epic MyChart (SMART on FHIR). Setup: docs/epic-mychart.md ----------------------
# Without EPIC_CLIENT_ID and EPIC_TOKEN_ENCRYPTION_KEY, /epic/* answers 503 and the
# dashboard shows "MyChart connection isn't configured yet".
# Non-Production Client ID from fhir.epic.com -> Build Apps (sandbox).
EPIC_CLIENT_ID=
# Only for a confidential client (needed for refresh tokens). Leave empty for PKCE-only.
EPIC_CLIENT_SECRET=
# FHIR R4 base; also sent as `aud`. Sandbox shown; a health system's base in production.
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# STU3 base used for labs (Epic's Observation.Search (Labs) API is STU3).
EPIC_STU3_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/STU3
# STU3 (default) or R4: which FHIR version to search labs on first.
EPIC_LABS_FHIR_VERSION=STU3
# Must match a redirect URI registered on the Epic app, character for character.
EPIC_REDIRECT_URI=http://localhost:3000/api/auth/callback/epic
# Space-separated. Leave empty for the default (openid fhirUser + patient/<5 resources>.read).
EPIC_SCOPES=
# Fernet key that encrypts stored tokens. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EPIC_TOKEN_ENCRYPTION_KEY=
# true while using Epic's sandbox (shows a sandbox note in the UI).
EPIC_SANDBOX=true

# ---- Texts and calls to the patient's own phone. Setup: docs/phone-outreach.md -------
# Without these, /outreach/* reports "not set up" and the dashboard buttons stay off.
# Apply database/patient_phone.sql and database/outreach.sql on Postgres first.
# Twilio (paid account; trials can't send custom texts). Console -> Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The purchased Twilio number, E.164 (e.g. +15551234567).
TWILIO_FROM_NUMBER=
# Optional: Messaging Service SID (MG...) for an A2P 10DLC campaign; used instead of From.
TWILIO_MESSAGING_SERVICE_SID=
# ElevenLabs (server-only key restricted to Agents). Calls use the agent's imported number.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# ElevenLabs -> Agents -> Phone Numbers -> the imported Twilio number's id.
ELEVENLABS_PHONE_NUMBER_ID=
# Link put in texts.
PUBLIC_APP_URL=https://cloudcare.icu
# Country calling codes CloudCare may text or call (comma-separated). Default: 1 (US/Canada).
OUTREACH_ALLOWED_COUNTRY_CODES=1
# Outbound calls send telephony_call_config.twilio_machine_detection = {mode: "enable",
# actions: [{action: "hang_up", answered_by: ["fax"]}]} (Twilio answering-machine detection).
# Machine verdicts never hang up, so phone call-screening assistants (iPhone Call Screening)
# still reach Foggy, which says who is calling. Set to false to send no machine detection.
OUTREACH_MACHINE_DETECTION=true
# telephony_call_config.ringing_timeout_secs: seconds the phone rings before giving up (10-120).
OUTREACH_RINGING_TIMEOUT_SECS=45

# ---- Foggy's language model ------------------------------------------------------
# gemini | ollama | none. Leave empty to choose automatically: gemini when LLM_API_KEY
# is set, otherwise ollama when OLLAMA_URL answers, otherwise none (keyword fallback).
LLM_PROVIDER=
# Gemini API key from https://aistudio.google.com/apikey (free tier). Server-only.
LLM_API_KEY=
# OpenAI-compatible base URL. Default: Gemini's. Any OpenAI-compatible API works here.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model id. List what your key can use: GET {LLM_BASE_URL}models with the key as Bearer.
# Each Foggy turn makes 1-2 calls (classifier + plan answer). Free-tier quotas are per
# model per day (gemini-3.6-flash: 20 requests/day; Flash-Lite models have their own
# quota). When the quota runs out Foggy keeps working on its rules (safety routes unchanged).
LLM_MODEL=gemini-3.6-flash
# Optional: low (default) | minimal | medium | high | off (don't send the parameter).
LLM_REASONING_EFFORT=

# Local development only: Ollama (https://ollama.com). Run `ollama pull llama3.2` first.
# Not used in deployed environments.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
