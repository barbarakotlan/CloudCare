# Copy this file to backend/.env and fill in real values. Never commit .env.

# Postgres connection string. Leave unset (or empty) to use the local SQLite file.
# Supabase: Dashboard -> Connect -> "Session pooler" (IPv4, port 5432). Copy the host
# from the dialog; postgresql:// URLs are converted to the psycopg driver automatically.
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres
# The transaction pooler (port 6543) also works; prepared statements are turned off for it.
# Create the tables once with database/scheme.sql, then run database/supabase_rls.sql.
DATABASE_URL=

# Secret for signing demo login tokens (POST /auth/login). Any long random string;
# share privately with the team. Required in any deployed environment.
JWT_SECRET=change-me-to-a-long-random-string

# Supabase Auth. Setting SUPABASE_URL makes the API accept Supabase access tokens
# (verified with the project's public signing keys, no secret needed for that).
SUPABASE_URL=
# Server-only key (legacy service_role JWT or a new sb_secret_ key). Used only at
# startup to create the demo accounts in Supabase Auth. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,https://cloudcare.icu,https://www.cloudcare.icu

# ---- Epic MyChart (SMART on FHIR). Setup: docs/epic-mychart.md ----------------------
# Without EPIC_CLIENT_ID and EPIC_TOKEN_ENCRYPTION_KEY, /epic/* answers 503 and the
# dashboard shows "MyChart connection isn't configured yet".
# Non-Production Client ID from fhir.epic.com -> Build Apps (sandbox).
EPIC_CLIENT_ID=
# Only for a confidential client (needed for refresh tokens). Leave empty for PKCE-only.
EPIC_CLIENT_SECRET=
# FHIR R4 base; also sent as `aud`. Sandbox shown; a health system's base in production.
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# STU3 base used for labs (Epic's Observation.Search (Labs) API is STU3).
EPIC_STU3_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/STU3
# STU3 (default) or R4: which FHIR version to search labs on first.
EPIC_LABS_FHIR_VERSION=STU3
# Must match a redirect URI registered on the Epic app, character for character.
EPIC_REDIRECT_URI=http://localhost:3000/api/auth/callback/epic
# Space-separated. Leave empty for the default (openid fhirUser + patient/<5 resources>.read).
EPIC_SCOPES=
# Fernet key that encrypts stored tokens. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EPIC_TOKEN_ENCRYPTION_KEY=
# true while using Epic's sandbox (shows a sandbox note in the UI).
EPIC_SANDBOX=true

# Local LLM for Foggy (https://ollama.com). Run `ollama pull llama3.2` first.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
