# Copy this file to backend/.env and fill in real values. Never commit .env.

# Postgres connection string (Supabase/Neon/local). Leave unset to use local SQLite.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Secret for signing login tokens. Any long random string; share privately with the team.
JWT_SECRET=change-me-to-a-long-random-string
